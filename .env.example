# Copiar a .env (ya está en .gitignore) y completar. docker-compose lo usa
# para dos cosas: interpolar variables dentro de docker-compose.yml, y
# inyectarlas al proceso del contenedor vía `env_file`.

# --- Login de dsh web (obligatorio; sin esto el proceso no bootea) ---
ADMIN_EMAIL=admin@ejemplo.com
ADMIN_PASSWORD=cambiame

# --- Proveedor LLM (opcional según qué uses adentro) ---
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=

# --- Solo si querés overridear defaults ---
# Puerto publicado en el host (por default 8080):
# DSH_WEB_PORT=8080
# Ruta al ~/.dsh real del host, si no querés el default de Windows
# (%USERPROFILE%\.dsh). Va literal, sin ${...} (Compose no expande dentro de .env):
# DSH_DATA_HOME=C:\Users\tu-usuario\.dsh
